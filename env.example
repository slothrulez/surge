# ============================================================================
# Payment Failure Auto-Responder — Environment Configuration
# Phase 1: Project Setup (Blueprint Part 11: Deployment)
# Copy this to .env and fill in your actual values
# ============================================================================

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000


# ============================================================================
# Database Configuration
# Reference: Blueprint Part 2 (Architecture) - PostgreSQL 14+
# ============================================================================
DATABASE_URL=postgresql://postgres:dev_password@localhost:5432/payment_recovery


# ============================================================================
# Redis Configuration
# Reference: Blueprint Part 2 (Architecture) - Redis 7+
# Used for: Webhook queues, idempotency key caching, rate limiting
# ============================================================================
REDIS_URL=redis://localhost:6379


# ============================================================================
# Razorpay API Credentials
# Reference: Blueprint Part 2 (Architecture)
# Get these from Razorpay dashboard (https://dashboard.razorpay.com)
# CRITICAL: Never commit these to version control
# ============================================================================

# Test mode key (for development)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXX

# Test mode secret (for webhook signature verification)
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXX

# Webhook secret (for signature verification)
# Get this from Razorpay webhook settings
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXX


# ============================================================================
# SMS Provider Configuration
# Blueprint Part 2 (Architecture) mentions: Twilio, MSG91, Razorpay's SMS API
# Choose one provider and set its credentials below
# ============================================================================

# Provider choice: "twilio", "msg91", or "razorpay_sms"
SMS_PROVIDER=twilio

# Twilio Configuration (if SMS_PROVIDER=twilio)
SMS_ACCOUNT_SID=AC0000000000000000000000000000
SMS_AUTH_TOKEN=00000000000000000000000000000000
SMS_FROM_NUMBER=+1234567890

# Alternatively, MSG91 Configuration (if SMS_PROVIDER=msg91)
# SMS_ACCOUNT_SID=your-msg91-api-key
# SMS_FROM_NUMBER=your-msg91-sender-id


# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO


# ============================================================================
# Feature Flags
# Blueprint Part 8: Safety Rules
# These gates control which recovery actions are available
# ============================================================================

# Enable automatic retry (AUTO_RETRY action)
# Blueprint line 219: retry_config with max_retries and delays
ENABLE_AUTO_RETRY=true

# Enable SMS notifications (SMS_CARD_UPDATE action)
# Blueprint line 223: sms_enabled
ENABLE_SMS=true

# Enable EMI/installments offers (OFFER_INSTALLMENTS action)
# Blueprint line 224: installments_enabled
ENABLE_INSTALLMENTS=true


# ============================================================================
# Safety Limits
# Blueprint Part 8: Safety Rules — limits that prevent abuse
# ============================================================================

# Maximum retries per payment
# Blueprint line 221: max_retries
MAX_RETRIES_GLOBAL=5

# Maximum SMS per customer per day
# Blueprint line 228: daily_sms_limit_per_customer
MAX_SMS_PER_CUSTOMER_PER_DAY=3
